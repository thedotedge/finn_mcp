{
  "name": "finn-mcp-server",
  "version": "1.0.2",
  "description": "Security-hardened fork of finn_mcp — MCP server for FINN.no / Klarna browsing",
  "main": "src/server.js",
  "bin": {
    "finn-mcp-server": "./src/server.js",
    "finn": "./src/cli.js"
  },
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "lint": "biome check",
    "format": "biome check --write",
    "cli": "node src/cli.js"
  },
  "keywords": [
    "mcp",
    "finn",
    "marketplace",
    "norway",
    "server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thedotedge/finn_mcp.git"
  },
  "bugs": {
    "url": "https://github.com/thedotedge/finn_mcp/issues"
  },
  "homepage": "https://github.com/thedotedge/finn_mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "cheerio": "^1.2.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "proxy-addr": "^2.0.8",
      "path-to-regexp": "^8.4.0",
      "undici": "^7.30.1",
      "hono": "^4.13.16",
      "@hono/node-server": "^2.1.3",
      "fast-uri": "^3.1.9",
      "ip-address": "^10.3.1",
      "body-parser": "^2.4.0",
      "qs": "^6.16.1"
    }
  },
  "author": "viktorfa",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.12"
  }
}
